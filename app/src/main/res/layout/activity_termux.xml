<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/neoterm_terminal_horizontal_margin"
        android:layout_marginVertical="0dp"
        android:orientation="vertical">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_extra_keys_dock"
            android:layout_height="match_parent">

            <!-- IMPORTANT: do NOT put blocksDescendants here. It used to wrap the
                 TerminalView and prevent it from ever taking focus, which killed
                 the soft keyboard. Chrome is marked non-focusable individually. -->
            <!-- TerminalView fills every pixel from top=0 down to the dock. The session pill
                 is a later sibling, so it paints ABOVE the terminal text as a true Z-order
                 overlay instead of reserving a 96dp row and pushing the canvas down. -->
            <RelativeLayout
                android:id="@+id/terminal_content_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/black"
                android:focusable="false"
                android:focusableInTouchMode="false">

                <!-- Transparent, non-interactive wrapper: touches in the side margins fall
                     through to TerminalView underneath; only the glass pill itself is live.
                     When collapsed it snaps to WRAP_CONTENT + alignParentEnd so the entire
                     top-left/top-center of TerminalView row 0 is exposed directly. -->
                <FrameLayout
                    android:id="@+id/terminal_session_tab_bar_slot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:elevation="@dimen/neoterm_pill_elevation"
                    android:background="@null"
                    android:clickable="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:descendantFocusability="blocksDescendants"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Kept only as an ID for legacy layouts. Never drawn: no colored banner,
                         no dark divider, no gradient above the terminal canvas. -->
                    <View
                        android:id="@+id/terminal_top_ambient_glow"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/neoterm_pill_slot_height"
                        android:background="@drawable/top_ambient_glow"
                        android:visibility="gone"
                        android:clickable="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false" />

                    <LinearLayout
                        android:id="@+id/terminal_session_tab_bar"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/neoterm_pill_height"
                        android:layout_marginStart="@dimen/neoterm_pill_side_margin"
                        android:layout_marginEnd="@dimen/neoterm_pill_side_margin"
                        android:layout_marginTop="@dimen/neoterm_pill_top_margin"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/session_tab_bar_background"
                        android:elevation="@dimen/neoterm_pill_elevation"
                        android:paddingStart="@dimen/neoterm_pill_horizontal_padding"
                        android:paddingEnd="@dimen/neoterm_pill_horizontal_padding"
                        android:paddingTop="@dimen/neoterm_pill_vertical_padding"
                        android:paddingBottom="@dimen/neoterm_pill_vertical_padding"
                        android:descendantFocusability="blocksDescendants"
                        android:focusable="false"
                        android:focusableInTouchMode="false">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/terminal_session_tabs"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/neoterm_tab_row_height"
                            android:layout_gravity="center_vertical"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/neoterm_tab_gap"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:clipToPadding="true"
                            android:requiresFadingEdge="horizontal"
                            android:fadingEdgeLength="@dimen/neoterm_tab_fading_edge_length"
                            android:overScrollMode="never"
                            android:background="@null"
                            android:descendantFocusability="blocksDescendants"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            tools:listitem="@layout/item_session_tab" />

                        <!-- Live theme switcher. Chrome only: never takes focus from TerminalView. -->
                        <ImageButton
                            android:id="@+id/theme_switcher_button"
                            android:layout_width="@dimen/neoterm_chevron_size"
                            android:layout_height="@dimen/neoterm_chevron_size"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="@dimen/neoterm_tab_gap"
                            android:src="@drawable/ic_palette"
                            android:background="@drawable/theme_button_background"
                            android:scaleType="centerInside"
                            android:padding="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            app:tint="@color/session_tab_add_icon"
                            android:contentDescription="@string/action_switch_theme"
                            android:focusable="false"
                            android:focusableInTouchMode="false" />

                        <ImageButton
                            android:id="@+id/new_session_tab_button"
                            android:layout_width="@dimen/neoterm_chevron_size"
                            android:layout_height="@dimen/neoterm_chevron_size"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="@dimen/neoterm_tab_gap"
                            android:src="@drawable/ic_add_session"
                            android:background="@drawable/add_session_button_background"
                            android:scaleType="centerInside"
                            android:padding="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            app:tint="@color/session_tab_add_icon"
                            android:contentDescription="@string/action_new_session"
                            android:focusable="false"
                            android:focusableInTouchMode="false" />

                        <!-- 34dp circular glass chevron. Haptic-only chrome: never focuses. -->
                        <ImageButton
                            android:id="@+id/pill_collapse_button"
                            android:layout_width="@dimen/neoterm_chevron_size"
                            android:layout_height="@dimen/neoterm_chevron_size"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="0dp"
                            android:src="@drawable/ic_pill_collapse"
                            android:background="@drawable/theme_button_background"
                            android:scaleType="centerInside"
                            android:padding="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            app:tint="@color/session_tab_add_icon"
                            android:contentDescription="@string/action_collapse_pill"
                            android:descendantFocusability="blocksDescendants"
                            android:focusable="false"
                            android:focusableInTouchMode="false" />

                    </LinearLayout>

                    <!-- COLLAPSED: 36dp glass mini pill docked top-end. Only the live busy/idle
                         dot and the expand chevron remain; every expanded control is GONE. -->
                    <LinearLayout
                        android:id="@+id/mini_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/neoterm_mini_pill_height"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="@dimen/neoterm_mini_pill_margin"
                        android:layout_marginEnd="@dimen/neoterm_mini_pill_margin"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="6dp"
                        android:paddingEnd="3dp"
                        android:background="@drawable/session_tab_bar_background"
                        android:elevation="@dimen/neoterm_pill_elevation"
                        android:visibility="gone"
                        android:descendantFocusability="blocksDescendants"
                        android:clickable="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false">

                        <View
                            android:id="@+id/mini_pill_status_dot"
                            android:layout_width="@dimen/neoterm_mini_status_dot_size"
                            android:layout_height="@dimen/neoterm_mini_status_dot_size"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/mini_pill_status_dot"
                            android:clickable="false"
                            android:focusable="false"
                            android:focusableInTouchMode="false" />

                        <ImageButton
                            android:id="@+id/pill_expand_button"
                            android:layout_width="@dimen/neoterm_chevron_size"
                            android:layout_height="@dimen/neoterm_chevron_size"
                            android:src="@drawable/ic_pill_expand"
                            android:background="@drawable/theme_button_background"
                            android:scaleType="centerInside"
                            android:padding="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            app:tint="@color/session_tab_add_icon"
                            android:contentDescription="@string/action_expand_pill"
                            android:descendantFocusability="blocksDescendants"
                            android:focusable="false"
                            android:focusableInTouchMode="false" />
                    </LinearLayout>

                </FrameLayout>

                <com.termux.view.TerminalView
                    android:id="@+id/terminal_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentBottom="true"
                    android:background="@android:color/black"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clipToPadding="false"
                    android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                    android:scrollbars="vertical"
                    tools:ignore="UnusedAttribute" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/left_drawer"
                android:layout_width="240dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:choiceMode="singleChoice"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:descendantFocusability="blocksDescendants"
                android:orientation="vertical"
                android:background="?attr/termuxActivityDrawerBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageButton
                        android:id="@+id/settings_button"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_settings"
                        android:background="@null"
                        android:contentDescription="@string/action_open_settings"
                        app:tint="?attr/termuxActivityDrawerImageTint" />
                </LinearLayout>

                <ListView
                    android:id="@+id/terminal_sessions_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="top"
                    android:layout_weight="1"
                    android:choiceMode="singleChoice"
                    android:longClickable="true" />

                <LinearLayout
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/toggle_keyboard_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_toggle_soft_keyboard" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/new_session_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_new_session" />
                </LinearLayout>
            </LinearLayout>

        </androidx.drawerlayout.widget.DrawerLayout>

        <!-- Floating glass dock. The pager is the FIRST child and owns all remaining
             width (0dp + weight=1); the chevron is the SECOND child. Symmetric 6dp
             padding and baselineAligned=false keep the weighted page full width.
             Collapse hides the pager and shrinks the dock to WRAP_CONTENT; alignParentEnd
             pins that compact pill to the right edge. animateLayoutChanges stays OFF:
             a LayoutTransition on this container breaks ViewPager child measurement. -->
        <LinearLayout
            android:id="@+id/terminal_extra_keys_dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:animateLayoutChanges="false"
            android:layout_marginStart="@dimen/extra_keys_dock_side_margin"
            android:layout_marginEnd="@dimen/extra_keys_dock_side_margin"
            android:layout_marginBottom="@dimen/neoterm_dock_bottom_margin"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:background="@drawable/extra_keys_dock_background"
            android:elevation="@dimen/neoterm_dock_elevation"
            android:paddingStart="@dimen/neoterm_dock_padding"
            android:paddingEnd="@dimen/neoterm_dock_padding"
            android:paddingTop="@dimen/neoterm_dock_padding"
            android:paddingBottom="@dimen/neoterm_dock_padding"
            android:visibility="gone"
            android:descendantFocusability="blocksDescendants"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/terminal_toolbar_view_pager"
                android:layout_width="0dp"
                android:layout_height="@dimen/extra_keys_dock_height"
                android:layout_weight="1"
                android:background="@null"
                android:descendantFocusability="blocksDescendants"
                android:focusable="false"
                android:focusableInTouchMode="false" />

            <ImageButton
                android:id="@+id/extra_keys_collapse_button"
                android:layout_width="@dimen/neoterm_chevron_size"
                android:layout_height="@dimen/neoterm_chevron_size"
                android:layout_marginStart="@dimen/neoterm_tab_gap"
                android:src="@drawable/ic_chevron_down"
                android:background="@drawable/extra_keys_toggle_background"
                android:scaleType="centerInside"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:contentDescription="@string/action_collapse_extra_keys"
                android:focusable="false"
                android:focusableInTouchMode="false" />

        </LinearLayout>

    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent" />

</com.termux.app.terminal.TermuxActivityRootView>
