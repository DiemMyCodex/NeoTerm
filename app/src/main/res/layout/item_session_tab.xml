<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/session_tab_root"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/neoterm_tab_row_height"
    android:layout_gravity="center_vertical"
    android:minWidth="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="4dp"
    android:background="@drawable/session_tab_background"
    android:descendantFocusability="blocksDescendants"
    android:focusable="false"
    android:focusableInTouchMode="false">

    <View
        android:id="@+id/session_tab_status_dot"
        android:layout_width="@dimen/neoterm_status_dot_size"
        android:layout_height="@dimen/neoterm_status_dot_size"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="@dimen/neoterm_tab_gap"
        android:background="@drawable/session_status_dot"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <TextView
        android:id="@+id/session_tab_title"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxWidth="@dimen/neoterm_tab_title_max_width"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="13sp"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <ImageButton
        android:id="@+id/session_tab_close"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:padding="3dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_tab_close"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/neoterm_tab_close_inactive"
        android:contentDescription="@string/action_close_session"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:focusable="false"
        android:focusableInTouchMode="false" />

</LinearLayout>
