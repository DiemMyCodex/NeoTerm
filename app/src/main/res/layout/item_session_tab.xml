<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/session_tab_root"
    android:layout_width="140dp"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="2dp"
    android:descendantFocusability="blocksDescendants"
    android:focusable="false"
    android:focusableInTouchMode="false">

    <TextView
        android:id="@+id/session_tab_title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <ImageButton
        android:id="@+id/session_tab_close"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close_session"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="?attr/termuxActivityDrawerImageTint"
        android:contentDescription="@string/action_close_session"
        android:focusable="false"
        android:focusableInTouchMode="false" />

</LinearLayout>
