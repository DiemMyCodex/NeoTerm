<?xml version="1.0" encoding="utf-8"?>
<!-- Swatch chip in a theme row. Both fill and stroke are replaced at runtime. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/neoterm_theme_swatch_radius" />
    <solid android:color="@color/neoterm_glass_surface" />
    <stroke
        android:width="@dimen/neoterm_hairline"
        android:color="@color/neoterm_glass_stroke" />
</shape>
