<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent circular keycap with ripple feedback for the + action. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/neoterm_glass_stroke">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/neoterm_glass_fill" />
        </shape>
    </item>
</ripple>
