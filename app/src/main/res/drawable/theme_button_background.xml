<?xml version="1.0" encoding="utf-8"?>
<!-- Circular glass keycap for the palette button. Fill and stroke are retinted at runtime. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/neoterm_glass_stroke">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/neoterm_glass_fill" />
            <stroke
                android:width="@dimen/neoterm_hairline"
                android:color="@color/neoterm_glass_stroke" />
        </shape>
    </item>
</ripple>
